# docker compose(로컬 공유)와 배포 플랫폼에 넣을 환경변수 목록. 이 파일을 .env 로 복사해 값을 채운다.
# 실제 값이 들어간 .env 는 .gitignore 대상이다. 이 파일(.env.example)에는 값을 넣지 않는다.

# ---- 필수 (비어 있으면 서버가 시작하지 않거나 compose가 멈춘다)
# MySQL root 비밀번호(compose의 db 컨테이너와 앱이 함께 쓴다). 직접 정한다.
DB_PASSWORD=
# JWT 서명 비밀키: 32자 이상의 임의 문자열. 만드는 법(PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
# 시연 계정(admin@demo.local, user1@demo.local, user2@demo.local)의 비밀번호. 8자 이상, 기본값 없음.
# 비밀번호는 저장소에 적지 말고 제출할 때 따로 전달한다.
DEMO_ACCOUNT_PASSWORD=

# ---- 선택
# DB 이름(기본 thatsmine)
DB_NAME=thatsmine
# Kakao JavaScript 키: 비워 두면 지도 대신 안내와 건물별 목록으로 동작한다. 이미지를 만들 때(빌드) 들어간다.
VITE_KAKAO_MAP_KEY=
