# 이 파일을 복사해 frontend/.env 를 만들고 값을 채운다. (.env는 Git에 올라가지 않는다)

# Kakao Maps JavaScript 키 (Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키)
# 플랫폼 > Web 사이트 도메인에 http://localhost:5173 을 등록해야 지도가 보인다.
# 비워 두면 지도 대신 "시연용 위치 선택"과 건물별 목록으로 동작한다.
VITE_KAKAO_MAP_KEY=

# API 주소. 개발 서버에서는 Vite 프록시(/api → localhost:8080)를 쓰므로 그대로 둔다.
VITE_API_BASE_URL=/api/v1

# 캠퍼스 지도 중심(시연용 기본값). 실제 학교 좌표로 바꾸려면 아래 값을 고친다.
VITE_CAMPUS_CENTER_LAT=37.4979
VITE_CAMPUS_CENTER_LNG=126.9572
# 지도 확대 수준(1~14, 작을수록 확대)
VITE_CAMPUS_MAP_LEVEL=3
