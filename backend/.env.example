# 이 값들을 환경변수로 설정한다(실제 값이 든 파일은 Git에 올리지 않는다).
# PowerShell 예: $env:DB_PASSWORD="..." ; $env:JWT_SECRET="..."

# Database (MySQL 8.4)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=thatsmine
DB_USER=root
DB_PASSWORD=

# JWT 비밀키: 32자 이상의 임의 문자열. 기본(운영) 프로필은 이 값이 없으면 시작하지 않는다.
# 만들기 예(PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
# 토큰 유효 시간(밀리초). 86400000 = 24시간
JWT_EXPIRATION=86400000

# 업로드 사진 저장 폴더
UPLOAD_DIR=uploads

# dev 프로필 시연 계정 비밀번호(기본 demo1234!)
# DEMO_ACCOUNT_PASSWORD=원하는비밀번호   (빈 값으로 설정하면 로그인할 수 없으니 쓰지 않을 때는 설정하지 않는다)
